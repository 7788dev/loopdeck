APP_DEBUG=false
APP_PORT=8001
APP_IMAGE=ghcr.io/7788dev/loopdeck:latest
TZ=Asia/Shanghai

# 默认直接运行 sh docker/deploy.sh；空值会自动生成并保存，无需手工填写。
# MYSQL_HOST=db 使用内置 MySQL；自定义主机时填写现有数据库名、用户名和密码。
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
CRON_KEY=
# 由部署脚本根据 MYSQL_HOST 自动选择；外部数据库模式为空。
COMPOSE_PROFILES=local-db
AUTO_UPDATE_ENABLED=true
UPDATE_VERSION_SOURCES=https://api.github.com/repos/7788dev/loopdeck/contents/VERSION?ref=main,https://cdn.jsdelivr.net/gh/7788dev/loopdeck@main/VERSION,https://raw.githubusercontent.com/7788dev/loopdeck/main/VERSION,https://gh-proxy.com/raw.githubusercontent.com/7788dev/loopdeck/main/VERSION,https://ghfast.top/https://raw.githubusercontent.com/7788dev/loopdeck/main/VERSION
UPDATE_IMAGE_REPOSITORIES=ghcr.io/7788dev/loopdeck,ghcr.nju.edu.cn/7788dev/loopdeck,ghcr.1ms.run/7788dev/loopdeck,docker.1ms.run/ghcr.io/7788dev/loopdeck
UPDATE_CHECK_INTERVAL_SECONDS=21600
UPDATE_RETRY_INTERVAL_SECONDS=300
UPDATE_PROBE_TIMEOUT_SECONDS=8
UPDATE_PULL_TIMEOUT_SECONDS=900

# Defaults are tuned for a 2-core server with roughly 2 GB RAM.
APP_MEMORY_LIMIT=448m
APP_MEMORY_SWAP_LIMIT=512m
APP_CPU_LIMIT=1.50
DB_MEMORY_LIMIT=640m
DB_MEMORY_SWAP_LIMIT=768m
DB_CPU_LIMIT=1.25
SCHEDULER_MEMORY_LIMIT=32m
SCHEDULER_CPU_LIMIT=0.10
UPDATER_MEMORY_LIMIT=96m
UPDATER_CPU_LIMIT=0.25

PHP_FPM_PM_CONTROL=ondemand
PHP_FPM_PM_MAX_CHILDREN=4
PHP_FPM_PM_PROCESS_IDLE_TIMEOUT=10s
PHP_MEMORY_LIMIT=192M

SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_BATCH_SIZE=50
SCHEDULER_WORKERS=2
SCHEDULER_TIME_BUDGET_SECONDS=50
SCHEDULER_JITTER_SECONDS=120
SCHEDULER_RETRY_JITTER_SECONDS=60
TASK_LOG_RETENTION_DAYS=30
TASK_LOG_PRUNE_BATCH_SIZE=5000
DAKA_STATE_RETENTION_DAYS=30

MYSQL_MAX_CONNECTIONS=50
MYSQL_INNODB_BUFFER_POOL_SIZE=128M
MYSQL_INNODB_LOG_BUFFER_SIZE=16M
MYSQL_KEY_BUFFER_SIZE=16M
MYSQL_TMP_TABLE_SIZE=32M
MYSQL_TABLE_OPEN_CACHE=256
MYSQL_THREAD_CACHE_SIZE=8

LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
