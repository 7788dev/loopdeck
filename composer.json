{
    "name": "7788dev/loopdeck",
    "description": "LoopDeck multi-service automation panel",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "guzzlehttp/guzzle": "^7.15",
        "topthink/framework": "^8.1.4",
        "topthink/think-captcha": "^3.0.11",
        "topthink/think-multi-app": "^1.1.1",
        "topthink/think-orm": "^3.0.34",
        "topthink/think-view": "^2.0.5"
    },
    "require-dev": {
        "symfony/var-dumper": "^6.4",
        "topthink/think-trace": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        },
        "classmap": [
            "extend/"
        ],
        "exclude-from-classmap": [
            "extend/safe/360webscan.php"
        ]
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    }
}
