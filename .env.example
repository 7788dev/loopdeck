APP_DEBUG=false
APP_PORT=8001
APP_IMAGE=ghcr.io/7788dev/loopdeck:latest
TZ=Asia/Shanghai

MYSQL_DATABASE=loopdeck
MYSQL_USER=loopdeck
MYSQL_PASSWORD=replace_with_a_random_password
MYSQL_ROOT_PASSWORD=replace_with_another_random_password
CRON_KEY=replace_with_a_long_random_cron_key

# Defaults are tuned for a 2-core server with roughly 2 GB RAM.
APP_MEMORY_LIMIT=448m
APP_MEMORY_SWAP_LIMIT=512m
APP_CPU_LIMIT=1.50
DB_MEMORY_LIMIT=640m
DB_MEMORY_SWAP_LIMIT=768m
DB_CPU_LIMIT=1.25
SCHEDULER_MEMORY_LIMIT=32m
SCHEDULER_CPU_LIMIT=0.10

PHP_FPM_PM_CONTROL=ondemand
PHP_FPM_PM_MAX_CHILDREN=4
PHP_FPM_PM_PROCESS_IDLE_TIMEOUT=10s
PHP_MEMORY_LIMIT=192M

SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_BATCH_SIZE=50
SCHEDULER_WORKERS=2
SCHEDULER_TIME_BUDGET_SECONDS=50
SCHEDULER_JITTER_SECONDS=120
SCHEDULER_RETRY_JITTER_SECONDS=60
TASK_LOG_RETENTION_DAYS=30
TASK_LOG_PRUNE_BATCH_SIZE=5000

MYSQL_MAX_CONNECTIONS=50
MYSQL_INNODB_BUFFER_POOL_SIZE=128M
MYSQL_INNODB_LOG_BUFFER_SIZE=16M
MYSQL_KEY_BUFFER_SIZE=16M
MYSQL_TMP_TABLE_SIZE=32M
MYSQL_TABLE_OPEN_CACHE=256
MYSQL_THREAD_CACHE_SIZE=8

LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
