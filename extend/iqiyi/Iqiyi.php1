<?php
namespace iqiyi;

error_reporting(0);

/**
 * 爱奇艺签到工具类
 */

class Iqiyi
{
	public $cookiezt = 0;
	public $taskzt = 0;
	public $msg = [];
	private $P00001; //token
	private $P00003; //userId
	private $cookie;
	private $_USERAGENT='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/99.0.4844.51 Safari/537.36 Edg/99.0.1150.39';
	private $realip;

	public function __construct($P00001 = null, $P00003 = null, $config = [])
	{
		$this->P00001 = $P00001;
		$this->P00003 = $P00003;
		if ($P00001 && $P00003) {
			$this->cookie = "P00001={$P00001}; P00003={$P00003};";
		}
	}

	public function setRealIp($ip)
	{
		$this->realip = $ip;
	}
	
	//获取会员信息
	public function get_info()
	{
		$url = 'http://serv.vip.iqiyi.com/vipgrowth/query.action';
		$payload = [];
		$res = $this->curl($url, $payload, $this->cookie);
		$arr = json_decode($res, true);
		return $arr;
	}

	//会员中心签到
	public function member_sign()
	{
		$query = [
			"agentType" => "1",
			"agentversion" => "1.0",
			"appKey" => "basic_pcw",
			"authCookie" => $this->P00001,
			"qyid" => md5(uniqid()),
			"task_code" => "natural_month_sign",
			"timestamp" => $this->getMillisecond(),
			"typeCode" => "point",
			"userId" => $this->P00003,
		];
		$post = [
			"natural_month_sign" => [
				"agentType" => "1",
				"agentversion" => "1",
				"authCookie" => $this->P00001,
				"qyid" => md5(uniqid()),
				"taskCode" => "iQIYI_mofhr",
				"verticalCode" => "iQIYI"
			]
		];
		$query['sign'] = $this->getSign($query, 'UKobMjDMsDoScuWOfp6F');
		$url = 'https://community.iqiyi.com/openApi/task/execute?' . http_build_query($query);
		$res = $this->curl($url, $post, $this->cookie, true);
		$arr = json_decode($res, true);
		if ($arr['code'] == 'A00000') {
			if ($arr['data']['code'] == 'A0000') {
				$rewardCount = $arr['data']['data']['rewards'][0]['rewardCount']; // 积分
				$continued = $arr['data']['data']['signDays']; // 签到天数
				return resultArray(1, '会员中心签到成功：获得积分' . $rewardCount . '，累计签到' . $continued . '天');
			} elseif ($arr['data']['code'] == 'A0014') {
				return resultArray(1, "会员中心签到今日已完成");
			} elseif ($arr['data']['code'] == 'A0003') {
				$this->cookiezt = 1;
				return resultArray(0, '会员中心签到失败：' . $arr['data']['msg']);
			} else {
				$this->taskzt++;
				return resultArray(0, '会员中心签到失败：' . $arr['data']['msg']);
			}
		} elseif($arr['code'] == 'A00401') {
			$this->cookiezt = 1;
			$this->taskzt++;
			return resultArray(0, '会员中心签到失败：' . $arr['message']);
		} else {
			$this->taskzt++;
			return resultArray(0, '会员中心签到失败：' . $arr['message']);
		}
	}

	//积分中心签到
	public function score_sign()
	{
		$query = [
			"agenttype" => "1",
			"agentversion" => "0",
			"appKey" => "basic_pca",
			"appver" => "0",
			"authCookie" => $this->P00001,
			"channelCode" => "sign_pcw",
			//"dfp"=> $this->dfp,
			"scoreType" => "1",
			"srcplatform" => "1",
			"typeCode" => "point",
			"userId" => $this->P00003,
			"user_agent" => $this->_USERAGENT,
			"verticalCode" => "iQIYI"
		];
		$query['sign'] = $this->getSign($query, 'DO58SzN6ip9nbJ4QkM8H');
		$url = 'https://community.iqiyi.com/openApi/score/add?' . http_build_query($query);

		$res = $this->curl($url, null, $this->cookie);
		$arr = json_decode($res, true);
		if ($arr['code'] == 'A00000') {
			if ($arr['data'][0]['code'] == 'A0000') {
				$quantity = $arr['data'][0]['score'];
				$continued = $arr['data'][0]['continuousValue'];
				return resultArray(1, '积分中心签到成功：获得积分' . $quantity . '，累计签到' . $continued . '天');
			} elseif ($arr['data'][0]['code'] == 'A0002') {
				return resultArray(1, "积分中心签到今日已完成");
			} else {
				$this->taskzt++;
				return resultArray(0, '积分中心签到失败：' . $arr['data'][0]['message']);
			}
		}else{
			$this->taskzt++;
			return resultArray(0, '积分中心签到失败：' . $arr['message']);
		}
	}

	//积分中心访问热点任务
	public function score_hot()
	{
		$query = [
			'agenttype' => '1',
			'agentversion' => '0',
			'appKey' => 'basic_pcw',
			'appver' => '0',
			'authCookie' => $this->P00001,
			'channelCode' => 'paopao_pcw',
			'scoreType' => '1',
			'srcplatform' => '1',
			'typeCode' => 'point',
			'userId' => $this->P00003,
			'user_agent' =>$this->_USERAGENT,
			'verticalCode' => 'iQIYI',
		];
		$query['sign'] = $this->getSign($query, 'UKobMjDMsDoScuWOfp6F');
		//热点任务
		$url = 'https://community.iqiyi.com/openApi/task/complete?'.http_build_query($query);
		$res = $this->curl($url, null, $this->cookie);
		$arr = json_decode($res, true);
		if($arr['code'] == 'A00000'){
			//领取积分
			$url = 'https://community.iqiyi.com/openApi/score/getReward?'.http_build_query($query);
			$res = $this->curl($url, null, $this->cookie);
			$arr = json_decode($res, true);
			if($arr['code'] == 'A00000'){
				$score = $arr['data']['score'];
				return resultArray(1, '积分中心访问热点任务成功，积分+'.$score);
			}else{
				$this->taskzt++;
				return resultArray(1, '积分中心访问热点任务失败：'.$arr['msg']);
			}
		}elseif($arr['code'] == 'A0002'){
			return resultArray(0, "积分中心访问热点任务已完成");
		}else{
			$this->taskzt++;
			return resultArray(0, '积分中心访问热点任务失败：'.$arr['msg']);
		}
	}

	//积分中心观看视频任务
	public function score_video()
	{
		$query = [
			'agenttype' => '1',
			'agentversion' => '0',
			'appKey' => 'basic_pcw',
			'appver' => '0',
			'authCookie' => $this->P00001,
			'channelCode' => 'view_pcw',
			'scoreType' => '1',
			'srcplatform' => '1',
			'typeCode' => 'point',
			'userId' => $this->P00003,
			'user_agent' =>$this->_USERAGENT,
			'verticalCode' => 'iQIYI',
		];
		$query['sign'] = $this->getSign($query, 'UKobMjDMsDoScuWOfp6F');
		$url = 'https://community.iqiyi.com/openApi/score/add?'.http_build_query($query);
		for ($i = 0; $i < 3; $i++) {
			$res = $this->curl($url, null, $this->cookie);
			$arr = json_decode($res, true);
			if($arr['code'] == 'A00000'){
				if($arr['data'][0]['code'] == 'A0002'){
					break;
				}
			}else{
				$this->taskzt++;
				return resultArray(0, '积分中心观看视频任务失败：'.$arr['msg']);
			}
		}
		return resultArray(1, "积分中心观看视频任务执行成功");
	}

	//会员中心每日任务
	public function vipDailyTask(){
		$taskList = $this->query_task();
		if(count($taskList) > 0){
			$this->join_task($taskList);
			$taskList = $this->query_task();
			$this->task_reward($taskList);
			return resultArray(1, "会员中心日常任务完成");
		}else{
			return resultArray(1, "暂无会员中心每日任务");
		}
	}

	//获取任务列表
	public function query_task()
	{
		$url = 'https://tc.vip.iqiyi.com/taskCenter/task/queryUserTask';
		$data = [
			'P00001' => $this->P00001
		];
		$res = $this->curl($url, $data, $this->cookie);
		$arr = json_decode($res, true);
		if ($arr['code'] == 'A00000')
		{
			$taskList = [];
			foreach ($arr['data']['tasks']['daily'] as $row)
			{
				$taskList[] = [
					'name' => $row['name'],
					'taskCode' => $row['taskCode'],
					'status' => $row['status'],
					'taskReward' => $row["taskReward"]["task_reward_growth"],
				];
			}
			return $taskList;
		} else {
			$this->msg[] = '获取会员中心任务列表失败：' . $arr['msg'];
		}
	}

	//加入任务
	public function join_task($taskList = [])
	{
		$url = 'https://tc.vip.iqiyi.com/taskCenter/task/joinTask';
		$data = [
			'P00001' => $this->P00001,
			'taskCode' => "",
			'platform' => 'bb136ff4276771f3',
			'lang' => 'zh_CN',
		];
		foreach ($taskList as $item)
		{
			if ($item['status'] == 2)
			{
				$data['taskCode'] = $item['taskCode'];
				$this->curl($url.'?'.http_build_query($data), 0, $this->cookie);
			}
		}
	}

	//领取任务奖励
	public function task_reward($taskList = [])
	{
		$url = 'https://tc.vip.iqiyi.com/taskCenter/task/getTaskRewards';
		$data = [
			'P00001' => $this->P00001,
			'taskCode' => "",
			'platform' => 'bb136ff4276771f3',
			'lang' => 'zh_CN',
		];
		foreach ($taskList as $item)
		{
			if ($item['status'] == 0)
			{
				$data['taskCode'] = $item['taskCode'];
			} else if ($item['status'] == 4)
			{
				$data['taskCode'] = $item['taskCode'];
				//完成任务
				$this->curl('https://tc.vip.iqiyi.com/taskCenter/task/notify?'.http_build_query($data), 0, $this->cookie);
			} else if ($item['status'] == 1)
			{
				$this->msg[] = '会员中心任务《'.$item['name'].'》已完成，成长值+'.$item["taskReward"];
				continue;
			} else {
				continue;
			}
			$res = $this->curl($url.'?'.http_build_query($data), 0, $this->cookie);
			$arr = json_decode($res, true);
			if ($arr['code'] == 'A00000'){
				$this->msg[] = '会员中心任务《'.$item['name'].'》已完成，成长值+'.$item["taskReward"];
			}else{
				$this->msg[] = '会员中心任务《'.$item['name'].'》失败 '.$arr["msg"];
				$this->taskzt++;
			}
		}
	}


	//爱奇艺头条签到
	public function toutiao_sign()
	{
		$query = [
			'app_v' => '10.4.0',
			'platform_id' => '2',
			'ppuid' => $this->P00003,
			'qyid' => md5(uniqid()),
			'authCookie' => $this->P00001,
		];
		$url = 'https://toutiao.iqiyi.com/api/route/pps/cash/sign?'.http_build_query($query);
		$res = $this->curl($url);
		$arr = json_decode($res, true);
		if ($arr['code'] == 'A00000')
		{
			$this->msg[] = '爱奇艺头条签到成功';
		} elseif ($arr['code'] == 'EC0011')
		{
			$this->msg[] = '爱奇艺头条今日已签到';
		} else {
			$this->msg[] = '爱奇艺头条签到失败：'.$arr['msg'];
		}
	}

	//抽奖
	public function lottery()
	{
		$query = [
			"lottery_chance" => "1",
			"app_k" => md5(uniqid()),
			"app_v" => "11.6.5",
			"platform_id" => 10,
			"dev_os" => "8.0.0",
			"dev_ua" => "FRD-AL10",
			"net_sts" => '1',
			"qyid" => md5(uniqid()),
			"psp_uid" => $this->P00003,
			"psp_cki" => $this->P00001,
			"psp_status" => '3',
			"secure_v" => '1',
			"secure_p" => "GPhone",
			"req_sn" => $this->getMillisecond()
		];
		$url = "https://iface2.iqiyi.com/aggregate/3.0/lottery_activity?".http_build_query($query);
		$res = $this->curl($url, null, $this->cookie);
		$arr = json_decode($res, true);
		if (isset($arr['code']) && $arr['code'] == 0){
			if ($arr['daysurpluschance'] == 0) {
				$this->msg[] = '您的抽奖次数已经用完，明日再来吧';
			} else {
				$query['lottery_chance'] = 0;
				for ($i = 1; $i <= 3; $i++) {
					$url = "https://iface2.iqiyi.com/aggregate/3.0/lottery_activity?".http_build_query($query);
					$res = $this->curl($url, null, $this->cookie);
					$arr = json_decode($res, true);
					if ($arr['code'] == 0) {
						$chance = $arr['daysurpluschance']; // 剩余抽奖次数
						$award = $arr['awardName']; // 奖品名称
						$this->msg[] = '第' . $i . '次抽奖成功，奖品名称：' . $award;
					} else {
						$this->msg[] = '第' . $i . '次抽奖失败：' . $arr['kv']['msg'];
					}
				}
			}
		}else{
			$this->msg[] = '抽奖查询失败：' . $arr['errorReason'];
		}
	}

	public function getLoginToken()
    {
        $url = 'https://passport.iqiyi.com/apis/qrcode/gen_login_token.action';
        $payload = [
            'agenttype' => 1,
            'device_name' => '网页端',
            'formSDK' => 1,
            'ptid' => '01010021010000000000',
            'sdk_version' => '1.0.0',
            'surl' => 1,
        ];
        $raw = $this->curl2($url, $payload);
        $de_raw = json_decode($raw, true);
        if($de_raw){
            if($de_raw['code']=='A00000'){
                return ['code'=>1, 'token' => $de_raw['data']['token'], 'url' => $de_raw['data']['url']];
            }else{
                return ['code'=>-1, 'message' => $de_raw['msg']];
            }
        }else{
            return ['code'=>-1, 'msg' => '获取登录二维码失败'];
        }
    }

    public function qrLogin($token)
    {
        $url = 'https://passport.iqiyi.com/apis/qrcode/is_token_login.action';
        $payload = [
            'agenttype' => 1,
            'formSDK' => 1,
            'ptid' => '01010021010000000000',
            'sdk_version' => '1.0.0',
            'token' => $token,
        ];
        $raw = $this->curl2($url, $payload, null, true);
        $de_raw = json_decode($raw['body'], true);
        if ($de_raw['code'] == 'A00001') {
            return ['code'=>-1, 'message'=>'手机端尚未确认'];
        } elseif ($de_raw['code'] == 'P01006') {
            return ['code'=>2, 'message'=>'手机端已扫描但未确认'];
        } elseif ($de_raw['code'] == 'P00501' || $de_raw['code'] == 'P01007') {
            return ['code'=>3, 'message'=>'请重新获取二维码'];
        } elseif ($de_raw['code'] == 'A00000') {
            preg_match('/P00004=(.*?);/', $raw['header'], $P00004);
            preg_match('/P00001=(.*?);/', $raw['header'], $P00001);
            preg_match('/P00007=(.*?);/', $raw['header'], $P00007);
            preg_match('/P00003=(.*?);/', $raw['header'], $P00003);
            preg_match('/P00010=(.*?);/', $raw['header'], $P00010);
            preg_match('/P01010=(.*?);/', $raw['header'], $P01010);
            preg_match('/P00PRU=(.*?);/', $raw['header'], $P00PRU);
            $data = [
                'uid' => $de_raw['data']['userinfo']['uid'],
                'nickname' => $de_raw['data']['userinfo']['nickname'],
                'icon' => $de_raw['data']['userinfo']['icon'],
                'P00004' => $P00004[1],
                'P00001' => $P00001[1],
                'P00007' => $P00007[1],
                'P00003' => $P00003[1],
                'P00010' => $P00010[1],
                'P01010' => $P01010[1],
                'P00PRU' => $P00PRU[1],
            ];
            return ['code'=>1, 'data'=>$data];
        } else {
            return ['code'=>-1, 'message'=>$de_raw['msg']];
        }
    }

	
	private function curl($url,$data=null,$cookie=null,$json=false){
		$ch=curl_init();
		curl_setopt($ch,CURLOPT_URL,$url);
		$httpheader[] = "Accept: */*";
		$httpheader[] = "Accept-Language: zh-CN,zh;q=0.8";
		$httpheader[] = "Connection: keep-alive";
		if($json){
			$httpheader[] = "Content-Type: application/json";
		}
		if($this->realip){
			$httpheader[] = "X-Real-IP: ".$this->realip;
			$httpheader[] = "X-Forwarded-For: ".$this->realip;
		}
		curl_setopt($ch, CURLOPT_HTTPHEADER, $httpheader);
		if($data){
			if(is_array($data)){
				if($json){
					$data=json_encode($data);
				}else{
					$data=http_build_query($data);
				}
			}
			curl_setopt($ch,CURLOPT_POSTFIELDS,$data);
			curl_setopt($ch,CURLOPT_POST,1);
		}
		curl_setopt($ch,CURLOPT_SSL_VERIFYPEER, false);
		curl_setopt($ch,CURLOPT_SSL_VERIFYHOST, false);
		curl_setopt($ch,CURLOPT_RETURNTRANSFER, 1);
		curl_setopt($ch,CURLOPT_CONNECTTIMEOUT, 10);
		curl_setopt($ch,CURLOPT_REFERER, 'https://www.iqiyi.com/');
		if($cookie){
			curl_setopt($ch,CURLOPT_COOKIE, $cookie);
		}
		curl_setopt($ch,CURLOPT_USERAGENT, $this->_USERAGENT);
		$ret=curl_exec($ch);
		curl_close($ch);
		return $ret;
	}

	private function curl2($url,$data=null,$cookie=null,$split=false){
		$ch=curl_init();
		curl_setopt($ch,CURLOPT_URL,$url);
		$httpheader[] = "Accept: */*";
		$httpheader[] = "Accept-Language: zh-CN,zh;q=0.8";
		$httpheader[] = "Connection: keep-alive";
		if($this->realip){
			$httpheader[] = "X-Real-IP: ".$this->realip;
			$httpheader[] = "X-Forwarded-For: ".$this->realip;
		}
		curl_setopt($ch, CURLOPT_HTTPHEADER, $httpheader);
		if($data){
			if(is_array($data))$data=http_build_query($data);
			curl_setopt($ch,CURLOPT_POSTFIELDS,$data);
			curl_setopt($ch,CURLOPT_POST,1);
		}
		curl_setopt($ch,CURLOPT_SSL_VERIFYPEER, false);
		curl_setopt($ch,CURLOPT_SSL_VERIFYHOST, false);
		curl_setopt($ch,CURLOPT_RETURNTRANSFER, 1);
		curl_setopt($ch,CURLOPT_CONNECTTIMEOUT, 10);
		curl_setopt($ch,CURLOPT_REFERER, 'https://www.iqiyi.com/');
        if($cookie){
            curl_setopt($ch,CURLOPT_COOKIE, $cookie);
        }
        if($split){
			curl_setopt($ch,CURLOPT_HEADER, true);
		}
		curl_setopt($ch,CURLOPT_USERAGENT, 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/95.0.4638.69 Safari/537.36 Edg/95.0.1020.44');
		$ret=curl_exec($ch);
		if ($split) {
			$headerSize = curl_getinfo($ch, CURLINFO_HEADER_SIZE);
			$header = substr($ret, 0, $headerSize);
			$body = substr($ret, $headerSize);
			$ret=array();
			$ret['header']=$header;
			$ret['body']=$body;
		}
		curl_close($ch);
		return $ret;
	}

	private function getSign($data, $key)
	{
		$d = '';
		foreach ($data as $k=>$v)
		{
			$d .= $k .'=' . $v . '|';
		}
		return md5($d.$key);
	}

	private function getMillisecond() {
		list($s1, $s2) = explode(' ', microtime());
		return sprintf('%.0f', (floatval($s1) + floatval($s2)) * 1000);
	}
}